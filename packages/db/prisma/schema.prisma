generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployerType {
  SYSTEM_NPC
  COMPANY
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  OWNED
  LISTED
  RENTED
  VACANT
}

enum TenantType {
  NPC
  COMPANY
}

enum LeaseStatus {
  ACTIVE
  ENDED
}

enum CompanyStatus {
  ACTIVE
  FOR_SALE
  BANKRUPT
}

enum LenderType {
  SYSTEM
  COMPANY
}

enum LoanStatus {
  ACTIVE
  PAID
  DEFAULTED
}

enum CycleStatus {
  OPEN
  CLOSING
  CLOSED
}

// --- Géographie & fiscalité -------------------------------------------------

model Region {
  id             String         @id @default(uuid())
  name           String         @unique
  municipalities Municipality[]
}

model Municipality {
  id                          String  @id @default(uuid())
  region                      Region  @relation(fields: [regionId], references: [id])
  regionId                    String
  name                        String
  additionalTaxRate           Decimal @db.Decimal(5, 4)
  registrationDutyRate        Decimal @db.Decimal(5, 4)
  registrationDutyRateOwnHome Decimal @db.Decimal(5, 4)

  properties Property[]
  companies  Company[]

  @@unique([regionId, name])
}

/// Barème fiscal versionné par date d'effet — cf. section 7 du document de
/// conception. Les tranches sont stockées en JSON plutôt qu'en tables dédiées
/// pour rester ajustables sans migration à chaque réforme.
model TaxRuleSet {
  id                              String   @id @default(uuid())
  effectiveFrom                   DateTime
  taxFreeAllowance                Decimal  @db.Decimal(10, 2)
  ippBrackets                     Json
  socialContributionRateEmployee  Decimal  @db.Decimal(5, 4)
  selfEmployedBrackets             Json
  selfEmployedMinimumQuarterly    Decimal  @db.Decimal(10, 2)
  isocRate                        Decimal  @db.Decimal(5, 4)
  isocReducedRate                 Decimal  @db.Decimal(5, 4)
  isocReducedThreshold             Decimal  @db.Decimal(10, 2)
  capitalGainsRate                Decimal  @db.Decimal(5, 4)
  capitalGainsExemption           Decimal  @db.Decimal(10, 2)
  createdAt                       DateTime @default(now())
}

// --- Joueur & progression ----------------------------------------------------

model Player {
  id        String   @id @default(uuid())
  email     String   @unique
  pseudo    String   @unique
  createdAt DateTime @default(now())

  stats           PlayerStats?
  statHistory     PlayerStatHistory[]
  employments     Employment[]
  ownedProperties Property[]          @relation("PropertyOwner")
  bids            Bid[]
  companyShares   CompanyShare[]
  loans           Loan[]
  leasesAsTenant  Lease[]             @relation("LeaseTenantPlayer")
}

model PlayerStats {
  player          Player   @relation(fields: [playerId], references: [id])
  playerId        String   @id
  wealthLiquid    Decimal  @db.Decimal(14, 2) @default(0)
  wealthDisplayed Decimal  @db.Decimal(14, 2) @default(0)
  reputation      Decimal  @db.Decimal(5, 2)  @default(50)
  experience      Decimal  @db.Decimal(14, 2) @default(0)
  wellbeing       Decimal  @db.Decimal(5, 2)  @default(50)
  updatedAt       DateTime @updatedAt
}

/// Un instantané par cycle et par joueur — alimente les classements de
/// croissance récente (30-90 jours) évoqués en section 9.
model PlayerStatHistory {
  id         String  @id @default(uuid())
  player     Player  @relation(fields: [playerId], references: [id])
  playerId   String
  cycle      Cycle   @relation(fields: [cycleId], references: [id])
  cycleId    String
  wealth     Decimal @db.Decimal(14, 2)
  reputation Decimal @db.Decimal(5, 2)
  experience Decimal @db.Decimal(14, 2)
  wellbeing  Decimal @db.Decimal(5, 2)

  @@unique([playerId, cycleId])
}

model Employment {
  id           String       @id @default(uuid())
  player       Player       @relation(fields: [playerId], references: [id])
  playerId     String
  employerType EmployerType
  company      Company?     @relation(fields: [companyId], references: [id])
  companyId    String?
  role         String
  salary       Decimal      @db.Decimal(10, 2)
  startedCycle Int
  endedCycle   Int?
}

// --- Immobilier ---------------------------------------------------------------

model Property {
  id             String         @id @default(uuid())
  owner          Player?        @relation("PropertyOwner", fields: [ownerId], references: [id])
  ownerId        String?
  municipality   Municipality   @relation(fields: [municipalityId], references: [id])
  municipalityId String
  type           PropertyType
  baseRent       Decimal        @db.Decimal(10, 2)
  marketValue    Decimal        @db.Decimal(12, 2)
  condition      Decimal        @db.Decimal(5, 2) @default(100)
  status         PropertyStatus @default(VACANT)

  listings Listing[]
  leases   Lease[]
}

model Listing {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  price      Decimal  @db.Decimal(12, 2)
  isAuction  Boolean  @default(false)
  openedAt   DateTime @default(now())
  expiresAt  DateTime

  bids Bid[]
}

model Bid {
  id             String   @id @default(uuid())
  listing        Listing  @relation(fields: [listingId], references: [id])
  listingId      String
  player         Player   @relation(fields: [playerId], references: [id])
  playerId       String
  amount         Decimal  @db.Decimal(12, 2)
  isProxy        Boolean  @default(false)
  maxProxyAmount Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model Lease {
  id              String      @id @default(uuid())
  property        Property    @relation(fields: [propertyId], references: [id])
  propertyId      String
  tenantType      TenantType
  tenantPlayer    Player?     @relation("LeaseTenantPlayer", fields: [tenantPlayerId], references: [id])
  tenantPlayerId  String?
  tenantCompany   Company?    @relation(fields: [tenantCompanyId], references: [id])
  tenantCompanyId String?
  rentAmount      Decimal     @db.Decimal(10, 2)
  status          LeaseStatus @default(ACTIVE)
  startedCycle    Int
  endedCycle      Int?
}

// --- Entreprises ---------------------------------------------------------------

/// Chaîne de valeur en paliers (section 8) : une entreprise de niveau N achète
/// typiquement ses intrants à des entreprises de niveau N-1 via SupplyContract.
model Sector {
  id             String   @id @default(uuid())
  name           String   @unique
  level          Int
  parentSector   Sector?  @relation("SectorInputs", fields: [parentSectorId], references: [id])
  parentSectorId String?
  childSectors   Sector[] @relation("SectorInputs")

  companies Company[]
  contracts SupplyContract[]
}

model Company {
  id                  String        @id @default(uuid())
  sector              Sector        @relation(fields: [sectorId], references: [id])
  sectorId            String
  name                String
  municipality        Municipality  @relation(fields: [municipalityId], references: [id])
  municipalityId      String
  marketingInvestment Decimal       @db.Decimal(12, 2) @default(0)
  rdInvestment        Decimal       @db.Decimal(12, 2) @default(0)
  attractivenessScore Decimal       @db.Decimal(6, 2)  @default(0)
  status              CompanyStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())

  shares            CompanyShare[]
  employments       Employment[]
  cycleReports      CompanyCycleReport[]
  leasesAsTenant    Lease[]
  purchaseContracts SupplyContract[] @relation("SupplyBuyer")
  saleContracts     SupplyContract[] @relation("SupplySeller")
  loansAsLender     Loan[]
}

/// Base de l'actionnariat et du rachat hostile (section 12septies) : la somme
/// des sharePercentage pour une entreprise doit être maintenue à 100 côté
/// application.
model CompanyShare {
  company         Company @relation(fields: [companyId], references: [id])
  companyId       String
  player          Player  @relation(fields: [playerId], references: [id])
  playerId        String
  sharePercentage Decimal @db.Decimal(5, 2)

  @@id([companyId, playerId])
}

model CompanyCycleReport {
  id        String  @id @default(uuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  cycle     Cycle   @relation(fields: [cycleId], references: [id])
  cycleId   String
  revenue   Decimal @db.Decimal(14, 2)
  costs     Decimal @db.Decimal(14, 2)
  profit    Decimal @db.Decimal(14, 2)
  taxPaid   Decimal @db.Decimal(14, 2)

  @@unique([companyId, cycleId])
}

model SupplyContract {
  id              String  @id @default(uuid())
  buyer           Company @relation("SupplyBuyer", fields: [buyerCompanyId], references: [id])
  buyerCompanyId  String
  seller          Company @relation("SupplySeller", fields: [sellerCompanyId], references: [id])
  sellerCompanyId String
  sector          Sector  @relation(fields: [sectorId], references: [id])
  sectorId        String
  quantity        Decimal @db.Decimal(12, 2)
  price           Decimal @db.Decimal(12, 2)
  cycle           Cycle   @relation(fields: [cycleId], references: [id])
  cycleId         String
}

// --- Cycle & crédit ---------------------------------------------------------------

model Cycle {
  id        String      @id @default(uuid())
  number    Int         @unique
  startedAt DateTime    @default(now())
  closedAt  DateTime?
  status    CycleStatus @default(OPEN)

  statHistory     PlayerStatHistory[]
  cycleReports    CompanyCycleReport[]
  supplyContracts SupplyContract[]
}

model Loan {
  id                    String     @id @default(uuid())
  borrower              Player     @relation(fields: [borrowerPlayerId], references: [id])
  borrowerPlayerId      String
  lenderType            LenderType
  lenderCompany         Company?   @relation(fields: [lenderCompanyId], references: [id])
  lenderCompanyId       String?
  principal             Decimal    @db.Decimal(12, 2)
  rate                  Decimal    @db.Decimal(6, 4)
  termCycles            Int
  remainingBalance      Decimal    @db.Decimal(12, 2)
  collateralPropertyId  String?
  status                LoanStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
}
