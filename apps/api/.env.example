DATABASE_URL="postgresql://patrimoine:patrimoine@localhost:5432/patrimoine_jeu"
JWT_SECRET="dev-secret-change-me"
PORT=3001
WEB_URL="http://localhost:3000"

# Secret partagé avec le cron externe qui déclenche POST /cycles/internal-close
# (cf. .github/workflows/close-cycle.yml) — remplace le worker BullMQ/Redis.
INTERNAL_CYCLE_SECRET="dev-secret-change-me"

# Durée d'un cycle en ms — 30 minutes par défaut (30*60*1000). Un appel à
# /cycles/internal-close avant ce délai est un no-op, quelle que soit la
# fréquence du cron qui l'appelle. Les mécaniques calées en NOMBRE de
# cycles (pension, réserve de liquidation des dividendes, etc.) ne sont
# pas recalibrées en retour : leur durée réelle est divisée par deux en
# même temps que ce réglage (choix assumé).
CYCLE_DURATION_MS=1800000
